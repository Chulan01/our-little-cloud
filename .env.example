# =============================================================================
# Required for production / Vercel
# =============================================================================

# Public site URL used in magic-link OAuth redirects.
# On Vercel you can leave this empty — auto-detected from Vercel env vars
# (VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL).
# Self-host: set to your domain (e.g., https://our-little-cloud.example.com).
NEXT_PUBLIC_SITE_URL=

# Supabase project URL and anon key. Both REQUIRED on Vercel.
# Get them at: https://app.supabase.com >> Project Settings >> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# Optional — local-only mode (self-hosted demos only)
# =============================================================================
# When NEXT_PUBLIC_LOCAL_AUTH_ENABLED=true AND LOCAL_AUTH_USERS is set,
# the app uses work/local-data.json instead of Supabase.
# This mode is auto-disabled on Vercel (its filesystem is read-only).
# Leave as false for the Vercel deploy.
NEXT_PUBLIC_LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_USERS=Максим:password,Вика:password
